# Application
APP_ENV="development"                  # development | production

# ── Anthropic Claude (required from Phase 2) ───────────────────────────────
# Never commit a real key. Copy this file to .env and fill it in locally.
ANTHROPIC_API_KEY=""
SUFLER_MODEL="claude-sonnet-4-6"       # Claude model id (sonnet = faster/low-latency;
                                       # claude-opus-4-8 = more capable)
SUFLER_MODE="coach"                    # coach (3 опоры — говоришь сам) | answer (2–4 пункта)
SUFLER_ANSWER_LANG="ru"                # язык ответа суфлёра; термины остаются на English

# ── Speech-to-text (Phase 5+, Apple Silicon) ──────────────────────────────
SUFLER_STT_ENGINE="mlx"                # mlx | whispercpp | deepgram (stub)
SUFLER_STT_MODEL=""                    # MLX Whisper model; empty = default (whisper-large-v3-turbo).
                                       # Lighter/faster: mlx-community/whisper-small or whisper-tiny
SUFLER_LOOPBACK_DEVICE=""              # input device for the interviewer's voice; empty = default mic.
                                       # e.g. "BlackHole" — install it and route the call's audio there (Phase 7)

# ── Global hotkeys (Phase 3+, pynput syntax) ──────────────────────────────
SUFLER_HOTKEY_CAPTURE="<cmd>+<shift>+s"   # скрин → Claude
SUFLER_HOTKEY_PANIC="<cmd>+<shift>+h"     # мгновенно скрыть всё
SUFLER_HOTKEY_LAST="<cmd>+<shift>+a"      # ответить по последним N сек речи
