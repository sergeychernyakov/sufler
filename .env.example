# Application
APP_ENV="development"                  # development | production

# ── Answer LLM provider ────────────────────────────────────────────────────
SUFLER_LLM_PROVIDER="claude"           # claude (Anthropic, paid) | gemini (Google, free tier)
SUFLER_MODE="coach"                    # coach (3 опоры — говоришь сам) | answer (2–4 пункта)
SUFLER_ANSWER_LANG="ru"                # язык ответа суфлёра; термины остаются на English

# Claude (provider=claude). Never commit a real key — fill it in locally.
ANTHROPIC_API_KEY=""
SUFLER_MODEL="claude-sonnet-4-6"       # Claude model id (sonnet = faster; claude-opus-4-8 = smarter)

# Gemini (provider=gemini). Free key: https://aistudio.google.com/apikey
SUFLER_GEMINI_API_KEY=""
SUFLER_GEMINI_MODEL="gemini-2.0-flash" # free-tier, multimodal (reads screenshots), fast

# ── Speech-to-text (Phase 5+, Apple Silicon) ──────────────────────────────
SUFLER_STT_ENGINE="mlx"                # mlx | whispercpp | deepgram (stub)
SUFLER_STT_MODEL=""                    # MLX Whisper model; empty = default (whisper-large-v3-turbo).
                                       # Lighter/faster: mlx-community/whisper-small or whisper-tiny
SUFLER_STT_LANGUAGE=""                 # STT language: empty = auto-detect (best for ru+en mix);
                                       # set "ru" or "en" for a single-language session — removes
                                       # auto-detection garbage but transliterates the other language.
SUFLER_LOOPBACK_DEVICE=""              # input device for the interviewer's voice; empty = default mic.
                                       # e.g. "BlackHole" — install it and route the call's audio there (Phase 7)

# ── UI ────────────────────────────────────────────────────────────────────
SUFLER_STEALTH=""                      # empty/false = normal window (title bar, drag, ✕ to quit).
                                       # true = frameless stealth overlay (out of Dock, panic-hide)

# ── Global hotkeys (Phase 3+, pynput syntax) ──────────────────────────────
SUFLER_HOTKEY_CAPTURE="<cmd>+<shift>+s"   # скрин → Claude
SUFLER_HOTKEY_PANIC="<cmd>+<shift>+h"     # мгновенно скрыть всё
SUFLER_HOTKEY_LAST="<cmd>+<shift>+a"      # ответить по последним N сек речи
