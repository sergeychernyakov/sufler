#!/usr/bin/env bash
# bin/ci — run all local quality gates (mirrors the pre-commit/pre-push hooks).
#
# Usage:
#   bin/ci          run everything
#   bin/ci --fast   skip network/slow checks (pip-audit)
#
# Exit code is non-zero if any gate fails. Scaffold-aware: checks that need
# real code/tests are skipped while the project is still a skeleton.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
[ -d .venv/bin ] && PATH="$ROOT/.venv/bin:$PATH"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; BLUE=$'\033[0;34m'; BOLD=$'\033[1m'; NC=$'\033[0m'
PASS=0; FAIL=0; SKIP=0
FAST=false; [ "${1:-}" = "--fast" ] && FAST=true

have() { command -v "$1" >/dev/null 2>&1; }

run() {  # run <label> <cmd...>
  local label="$1"; shift
  printf "  ${BLUE}▸ %-30s${NC}" "$label"
  local out
  if out="$("$@" 2>&1)"; then
    printf "${GREEN}PASS${NC}\n"; PASS=$((PASS + 1))
  else
    printf "${RED}FAIL${NC}\n"; printf '%s\n' "$out" | tail -15 | sed 's/^/        /'; FAIL=$((FAIL + 1))
  fi
}

skip() { printf "  ${BLUE}▸ %-30s${NC}${YELLOW}SKIP${NC} %s\n" "$1" "${2:-}"; SKIP=$((SKIP + 1)); }

mkdir -p tmp/logs
targets=(src main.py)
[ -d tests ] && targets+=(tests)

echo ""
echo "${BOLD}════════════════════════════════════════════════${NC}"
echo "${BOLD}  SUFLER — local quality gates${NC}"
echo "${BOLD}════════════════════════════════════════════════${NC}"

echo ""; echo "${BOLD}  1. Format${NC}"
if have black; then run "black --check" black --check --quiet "${targets[@]}"; else skip "black --check" "(not installed)"; fi
if have isort; then run "isort --check" isort --check-only --profile black --line-length 120 "${targets[@]}"; else skip "isort --check" "(not installed)"; fi

echo ""; echo "${BOLD}  2. Lint${NC}"
if have ruff; then run "ruff" ruff check "${targets[@]}"; else skip "ruff" "(not installed)"; fi
if have pylint; then run "pylint (>=9.5)" pylint --rcfile=.pylintrc src main.py; else skip "pylint" "(not installed)"; fi

echo ""; echo "${BOLD}  3. Types${NC}"
if have mypy; then run "mypy" mypy --config-file pyproject.toml; else skip "mypy" "(not installed)"; fi

echo ""; echo "${BOLD}  4. Security${NC}"
if have bandit; then run "bandit" bandit -c pyproject.toml -q -r src main.py; else skip "bandit" "(pip install 'bandit[toml]')"; fi
run "secret scan" bin/hooks/secret-scan
if $FAST; then
  skip "pip-audit" "(--fast)"
elif have pip-audit; then
  run "pip-audit" pip-audit -r requirements.txt
else
  skip "pip-audit" "(pip install pip-audit)"
fi

echo ""; echo "${BOLD}  5. Tests + Coverage${NC}"
if ! have coverage; then
  skip "pytest" "(coverage not installed)"
  skip "coverage gate" "(coverage not installed)"
else
  cov_out="$(coverage run -m pytest -q 2>&1)"; rc=$?
  if [ "$rc" -eq 5 ]; then
    skip "pytest" "(no tests yet — scaffold)"
    skip "coverage gate" "(no tests yet — scaffold)"
  elif [ "$rc" -ne 0 ]; then
    printf "  ${BLUE}▸ %-30s${NC}${RED}FAIL${NC}\n" "pytest"
    printf '%s\n' "$cov_out" | tail -15 | sed 's/^/        /'
    FAIL=$((FAIL + 1))
  else
    printf "  ${BLUE}▸ %-30s${NC}${GREEN}PASS${NC}\n" "pytest"; PASS=$((PASS + 1))
    coverage json -o coverage.json -q 2>/dev/null || true
    run "coverage gate" python3 bin/check_coverage
  fi
fi

total=$((PASS + FAIL + SKIP))
echo ""
echo "${BOLD}════════════════════════════════════════════════${NC}"
printf "  ${GREEN}PASS %d${NC}    ${RED}FAIL %d${NC}    ${YELLOW}SKIP %d${NC}    (total %d)\n" "$PASS" "$FAIL" "$SKIP" "$total"
echo "${BOLD}════════════════════════════════════════════════${NC}"
echo ""
if [ "$FAIL" -gt 0 ]; then
  echo "  ${RED}${BOLD}Quality gate FAILED.${NC}"; echo ""; exit 1
fi
echo "  ${GREEN}${BOLD}Quality gate PASSED.${NC}"; echo ""; exit 0
