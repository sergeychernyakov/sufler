#!/usr/bin/env bash
# bin/hooks/secret-scan — fail on private keys or hardcoded credentials.
#
# Complements pre-commit's detect-private-key and bandit B105/B106.
set -uo pipefail

excludes=(
  --exclude-dir=.git --exclude-dir=.venv --exclude-dir=tmp --exclude-dir=media
  --exclude-dir=__pycache__ --exclude-dir=.mypy_cache --exclude-dir=.ruff_cache
  --exclude-dir=.pytest_cache --exclude-dir=.claude
)
status=0

pk="$(grep -rnI "${excludes[@]}" -e 'BEGIN[A-Z ]*PRIVATE KEY' \
  --include='*.py' --include='*.env' --include='*.json' --include='*.yml' --include='*.yaml' \
  . 2>/dev/null | grep -v 'bin/hooks/secret-scan' || true)"
if [ -n "$pk" ]; then
  echo "BLOCKED: private key material detected:"
  echo "$pk"
  status=1
fi

# Double-quoted literal secrets in Python, ignoring env-var lookups.
# tests/ is excluded: fixtures legitimately use fake keys (real keys are caught above).
cred="$(grep -rnEI "${excludes[@]}" --exclude-dir=tests \
  -e '(password|passwd|secret|api[_-]?key|token)[[:space:]]*=[[:space:]]*"[^"]{8,}"' \
  --include='*.py' . 2>/dev/null \
  | grep -vE 'os\.(getenv|environ)|getenv\(|environ\[' \
  | grep -v 'bin/hooks/secret-scan' || true)"
if [ -n "$cred" ]; then
  echo "BLOCKED: possible hardcoded credential (use environment variables / .env):"
  echo "$cred"
  status=1
fi

exit "$status"
