#!/usr/bin/env bash
# bin/hooks/protect-main — block direct commits/pushes to protected branches.
#
# Usage: protect-main <commit|push>
set -euo pipefail

action="${1:-commit}"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

case "$branch" in
  main | master)
    echo ""
    echo "BLOCKED: direct ${action} to '${branch}' is not allowed."
    echo ""
    echo "  Create a feature branch and open a PR:"
    echo "    git checkout -b feat/your-change"
    echo ""
    echo "  See docs/COMMIT_CONVENTION.md"
    echo ""
    exit 1
    ;;
esac
exit 0
